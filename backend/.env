# FinPilot AI Configuration

PROJECT_NAME="FinPilot AI - Enterprise Financial Operations Assistant"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Authentication & Security
SECRET_KEY="finpilot-enterprise-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (MySQL / SQLite Fallback)
# For MySQL: mysql+pymysql://user:password@localhost:3306/finpilot_db
DATABASE_URL="sqlite:///./finpilot.db"
# For Async MySQL: mysql+aiomysql://user:password@localhost:3306/finpilot_db
ASYNC_DATABASE_URL="sqlite+aiosqlite:///./finpilot.db"

# Groq LLM API Configuration
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# RAG & ChromaDB Configuration
CHROMA_PERSIST_DIR="./chroma_db"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# Compliance & Policy Guardrails
AUTO_APPROVAL_THRESHOLD_INR=25000.0
PII_REDACTION_ENABLED=True
